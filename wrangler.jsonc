{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maths-savvy-des",
  "main": "crates/site/build/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cargo install -q worker-build@^0.8 && worker-build --release crates/site"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Spoken sentences (MP3), keyed by voice + text: each one is synthesised only once.
  "kv_namespaces": [{ "binding": "TTS_AUDIO", "id": "44299c5166514cf6afe76d0dd3122a29" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "TTS_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "workers_dev": false,
  "routes": [{ "pattern": "maths.savvy-des.com", "custom_domain": true }]
}
